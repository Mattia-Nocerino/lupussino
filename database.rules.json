{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".write": "auth != null && !newData.exists() && auth.token.email === 'nocerino.mattia@gmail.com' && auth.token.email_verified === true",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt"
      ],
      ".write": "auth != null && !newData.exists() && auth.token.email === 'nocerino.mattia@gmail.com' && auth.token.email_verified === true",
      "$roomId": {
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid && newData.child('status').val() === 'lobby') || data.child('hostUid').val() === auth.uid || (!newData.exists() && (auth.token.email === 'nocerino.mattia@gmail.com' && auth.token.email_verified === true)))",
        "hostUid": {
          ".write": "auth != null && newData.val() === auth.uid && data.parent().child('players').child(auth.uid).exists() && (!data.parent().child('players').child(data.val()).exists() || (data.parent().child('players').child(data.val()).child('online').val() === false && data.parent().child('players').child(data.val()).child('visto').val() < now - 15000))"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.parent().parent().child('status').val() !== 'playing' || (data.exists() && newData.exists()))",
            ".validate": "!newData.exists() || (newData.child('nome').isString() && newData.child('nome').val().length <= 20)"
          }
        },
        "voted": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.val() === true && data.parent().parent().child('status').val() === 'playing' && data.parent().parent().child('inGioco').child($uid).exists() && (!data.parent().parent().child('fineVoto').exists() || now <= data.parent().parent().child('fineVoto').val() + 3000)"
          }
        }
      }
    },
    "hands": {
      ".write": "auth != null && !newData.exists() && auth.token.email === 'nocerino.mattia@gmail.com' && auth.token.email_verified === true",
      "$roomId": {
        ".write": "auth != null && (root.child('rooms').child($roomId).child('hostUid').val() === auth.uid || (!newData.exists() && (auth.token.email === 'nocerino.mattia@gmail.com' && auth.token.email_verified === true)))",
        "$round": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('hostUid').val() === auth.uid)"
          }
        }
      }
    },
    "secret": {
      ".write": "auth != null && !newData.exists() && auth.token.email === 'nocerino.mattia@gmail.com' && auth.token.email_verified === true",
      "$roomId": {
        ".read": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() === auth.uid",
        ".write": "auth != null && (root.child('rooms').child($roomId).child('hostUid').val() === auth.uid || (!newData.exists() && (auth.token.email === 'nocerino.mattia@gmail.com' && auth.token.email_verified === true)))"
      }
    },
    "votes": {
      ".write": "auth != null && !newData.exists() && auth.token.email === 'nocerino.mattia@gmail.com' && auth.token.email_verified === true",
      "$roomId": {
        ".write": "auth != null && !newData.exists() && (auth.token.email === 'nocerino.mattia@gmail.com' && auth.token.email_verified === true)",
        ".read": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() === auth.uid",
        "$round": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('status').val() === 'playing' && root.child('rooms').child($roomId).child('round').val() + '' === $round && root.child('rooms').child($roomId).child('inGioco').child($uid).exists() && (!root.child('rooms').child($roomId).child('fineVoto').exists() || now <= root.child('rooms').child($roomId).child('fineVoto').val() + 3000)",
            ".validate": "newData.hasChildren(['bersaglio']) && newData.child('bersaglio').isString() && (newData.child('bersaglio').val() === '__cielo__' || (newData.child('bersaglio').val() !== $uid && root.child('rooms').child($roomId).child('inGioco').child(newData.child('bersaglio').val()).exists())) && (!newData.child('cambi').exists() || newData.child('cambi').isNumber())"
          }
        }
      }
    },
    "games": {
      ".read": "auth != null",
      ".indexOn": [
        "finitaIl"
      ],
      ".write": "auth != null && !newData.exists() && auth.token.email === 'nocerino.mattia@gmail.com' && auth.token.email_verified === true",
      "$gameId": {
        ".write": "auth != null && !data.exists() && newData.child('hostUid').val() === auth.uid"
      }
    }
  }
}
